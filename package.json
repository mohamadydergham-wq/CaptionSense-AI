{
  "name": "caption-sense-ai",
  "version": "1.0.0",
  "description": "Live captions with tone detection and sentiment analysis for video calls",
  "author": "CaptionSense Team",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:watch",
    "build": "npm run build:ts && npm run build:webpack",
    "build:ts": "tsc",
    "build:watch": "concurrently \"tsc --watch\" \"webpack watch --mode development\"",
    "build:webpack": "webpack --mode production",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "backend:dev": "nodemon --exec ts-node src/backend/server.ts",
    "backend:build": "tsc --project tsconfig.backend.json",
    "backend:start": "node dist/backend/server.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.30.0",
    "express": "^4.18.2",
    "pdfkit": "^0.13.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^8.50.0",
    "@types/chrome": "^0.0.247",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.8.0",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "concurrently": "^8.2.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
